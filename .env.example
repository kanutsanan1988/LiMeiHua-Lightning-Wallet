# LiMeiHua Lightning Wallet - Environment Variables
# 
# ชุดซอฟต์แวร์ชุดนี้ มีไว้เพื่อเป็นโครงสร้างพื้นฐานทางการเงินยุคใหม่
# เพื่อรองรับการไหลของเงินจำนวนมหาศาลของท่านผู้เฒ่าหลี่เหมยฮัว หรือ LiMeiHua Grand Mother
# และ source code นี้สร้างโดย Mr.Kanutsanan Pongpanna (นายคณัสนันท์ พงษ์พันนา)
# URL: https://chatgpt.com/g/g-68d289535dec81919445deb9830f2d8e-kanutsanan-pongpanna

# Backend Configuration
PORT=3000
NODE_ENV=development

# Lightning Network Configuration
LIGHTNING_RPC_URL=http://localhost:10009
LIGHTNING_MACAROON_PATH=/path/to/admin.macaroon
LIGHTNING_CERT_PATH=/path/to/tls.cert

# Taproot Assets Configuration
TAPROOT_ASSETS_URL=http://localhost:8089
TAPROOT_ASSETS_API_KEY=your_api_key_here

# Bitcoin Configuration
BITCOIN_RPC_URL=http://localhost:8332
BITCOIN_RPC_USER=bitcoin
BITCOIN_RPC_PASSWORD=password

# Database Configuration
DATABASE_URL=mongodb://localhost:27017/limeihua_wallet
DATABASE_NAME=limeihua_wallet

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY=7d

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# API Keys
COINGECKO_API_KEY=your_coingecko_api_key
ETHERSCAN_API_KEY=your_etherscan_api_key

# Frontend Configuration
REACT_APP_API_URL=http://localhost:3000
REACT_APP_ENVIRONMENT=development

# Mobile Configuration
REACT_NATIVE_API_URL=http://localhost:3000

# Desktop Configuration
ELECTRON_DEV_TOOLS=true

# Security
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# Feature Flags
ENABLE_2FA=true
ENABLE_BIOMETRIC=true
ENABLE_HARDWARE_WALLET=true
ENABLE_MULTI_SIG=true
